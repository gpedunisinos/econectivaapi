APP_ENV=local
APP_NAME="Educação Onlife"
APP_URL=http://localhost:8080
APP_PORT=8080
API_CONTAINER_NAME=UnisinosUspAPI
API_IMAGE=onlife-api:local
APP_REVISION=unknown

TEMPERATURE=
TOP_P=
MAX_OUTPUT_TOKENS=
TOP_K= 
RESPONSE_MIME_TYPE=text/plain
GENAI_API_KEY=""
# Modelo fixo; não há fallback automático para outro modelo.
GEMINI_MODEL=gemini-3.8-flash
JITSI_PUBLIC_URL=https://meet.spotec.app

JIRA_URL=""
JIRA_USER=""
JIRA_ASSIGNEE=""
JIRA_API_TOKEN=""

DB_HOST=localhost
DB_DRIVER=mysql                          
DB_USER=root
DB_PASSWORD=
DB_NAME=database_name
DB_PORT=3306
# Nunca habilitar no deploy de integrações: preserva catálogos/colunas legados.
ALLOW_DESTRUCTIVE_LEGACY_MIGRATIONS=false

API_SECRET=
TOKEN_HOUR_LIFESPAN=24
GOOGLE_WEB_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_ID_IOS=
APPLE_CLIENT_ID_WEB=
APPLE_SERVICE_ID=

# Serviço responsável por consultar as bases nacionais de contexto ambiental.
# Deve expor POST /context e aceitar {"latitude": number, "longitude": number}.
ENVIRONMENTAL_CONTEXT_API_URL=
ENVIRONMENTAL_CONTEXT_API_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=smtp.server.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CHARSET=UTF-8
MAIL_AUTO_TLS=1

FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=

SENTRY_DSN=

GRYPHON_API_BASE_URL=http://54.94.107.155:8083/api
GRYPHON_API_TOKEN=
UNISINOS_USP_API_LOG_DIR=storage/logs
UNISINOS_USP_API_LOG_FILE_PREFIX=app

# Jitsi meeting authorization; use a dedicated secret of at least 32 bytes.
JITSI_PUBLIC_URL=https://meet.spotec.app
JITSI_APP_ID=onlife
JITSI_APP_SECRET=
JITSI_XMPP_DOMAIN=meet.jitsi

# Private pista attachments. Production uses the EC2 role, never access keys.
STORAGE_DRIVER=local
AWS_REGION=sa-east-1
S3_BUCKET=

# Iareté voice: credentials are server-only. Recordings are transient, never S3.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin

# Platform isolation (each deployment has its own .env and database user).
PLATFORM_ID=
EXPECTED_DATABASE_NAME=
PUBLIC_APP_URL=
API_ALLOWED_ORIGINS=
PRESENCE_ALLOWED_ORIGINS=
S3_ROLE_ARN=
# The same directory must be bind-mounted by both instances.
PLACE_SEARCH_SHARED_DIR=

# Optional: leave empty to disable the remote log endpoint.
API_LOG_ACCESS_TOKEN=

# Optional internal, CPU-only spaCy service. Blank disables suggestions.
CLUE_DISCOVERY_URL=

# Optional CDIG content synchronization. Disabled unless every required setting is present.
CDIG_SYNC_ENABLED=false
CDIG_BASE_URL=
CDIG_SOURCE_KEY=
CDIG_IMPORT_USER_ID=
# Use either an individual content:read token OR both email and password.
CDIG_API_TOKEN=
CDIG_EMAIL=
CDIG_PASSWORD=
# 0 = manual only; 1..168 = automatic interval in hours.
CDIG_SYNC_INTERVAL_HOURS=0
