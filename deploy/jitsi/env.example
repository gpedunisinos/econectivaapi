# Generated secrets belong only in the server's protected .env, never in Git.
COMPOSE_PROJECT_NAME=onlife-jitsi
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11248
CONFIG=/opt/onlife-jitsi/config
TZ=America/Sao_Paulo
PUBLIC_URL=https://meet.spotec.app
HTTP_PORT=127.0.0.1:8180
HTTPS_PORT=127.0.0.1:8181
JICOFO_REST_PORT=8183
JVB_COLIBRI_PORT=8182
JVB_PORT=10000
JVB_ADVERTISE_IPS=PUBLIC_IPV4
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=internal
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1
ENABLE_REQUIRE_DISPLAY_NAME=1
DEFAULT_LANGUAGE=pt-BR
DISABLE_DEEP_LINKING=1
ENABLE_P2P=0
ENABLE_RECORDING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_AUDIO_TRANSLATION=0
DISABLE_LOCAL_RECORDING=1
ENABLE_LOAD_TEST_CLIENT=0
JICOFO_MAX_MEMORY=256m
VIDEOBRIDGE_MAX_MEMORY=512m
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
